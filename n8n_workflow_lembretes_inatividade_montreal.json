    {
      "parameters": {
        "jsCode": "// Normaliza o array de atletas inativos retornado pelo Supabase\nconst rawData = $input.all();\nconst results = [];\n\nfor (const item of rawData) {\n  const data = item.json;\n  if (Array.isArray(data)) {\n    for (const sub of data) {\n      if (sub && sub.athlete_phone) {\n        results.push({ json: sub });\n      }\n    }\n  } else if (data && data.athlete_phone) {\n    results.push({ json: data });\n  }\n}\n\nreturn results;"
      },
