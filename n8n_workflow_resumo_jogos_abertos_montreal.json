      "position": [
        460,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normaliza a resposta da RPC. Se não houver jogos ou cooldown ativo, retorna vazio.\nconst rawData = $input.all();\nconst results = [];\n\nfor (const item of rawData) {\n  const data = item.json;\n  if (Array.isArray(data)) {\n    for (const sub of data) {\n      if (sub && sub.total_open_games > 0 && sub.formatted_message) {\n        results.push({ json: sub });\n      }\n    }\n  } else if (data && data.total_open_games > 0 && data.formatted_message) {\n    results.push({ json: data });\n  }\n}\n\nreturn results;"
      },
